    "[data-slot=\"tooltip-popup\"][data-instant]": {
      "transition-duration": "0ms"
    },
    ":is([data-slot=\"tooltip-positioner\"], [data-slot=\"popover-positioner\"])": {
      "transition-duration": "var(--duration-move)",
      "transition-timing-function": "var(--ease-in-out)"
    },
    ":is([data-slot=\"combobox-positioner\"], [data-slot=\"autocomplete-positioner\"]) > *": {
      "transition-property": "none"
    },
    ":is( [data-slot=\"dialog-backdrop\"], [data-slot=\"alert-dialog-backdrop\"], [data-slot=\"sheet-backdrop\"] )": {
      "transition-property": "opacity",
      "transition-duration": "var(--duration-modal)",
      "transition-timing-function": "var(--ease-out)"
    },
