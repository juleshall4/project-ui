    ":is( [data-slot=\"menu-popup\"], [data-slot=\"context-menu-popup\"], [data-slot=\"select-popup\"], [data-slot=\"popover-popup\"], [data-slot=\"preview-card-content\"] ):is([data-starting-style], [data-ending-style])": {
