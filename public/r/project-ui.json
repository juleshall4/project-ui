      "transition-property": "none"
    },
    ":is([data-slot=\"accordion-panel\"], [data-slot=\"collapsible-panel\"])": {
      "transition-property": "height, opacity",
      "transition-duration": "var(--duration-collapse)",
      "transition-timing-function": "var(--ease-out)"
    },
    ":is([data-slot=\"accordion-panel\"], [data-slot=\"collapsible-panel\"]):is([data-starting-style], [data-ending-style])": {
      "opacity": "0"
    },
    "[data-slot=\"accordion-trigger\"]": {
      "transition-property": "color, background-color, box-shadow"
    },
    "[data-slot=\"accordion-indicator\"]": {
      "transition-duration": "var(--duration-collapse)",
      "transition-timing-function": "var(--ease-in-out)"
    },
    "[data-slot=\"tab-indicator\"]": {
      "transition-duration": "var(--duration-move)",
      "transition-timing-function": "var(--ease-in-out)"
    },
    "[data-slot=\"switch-thumb\"]": {
      "transition-timing-function": "var(--ease-toggle)"
    },
    "[data-slot=\"button\"]": {
      "transition-property": "box-shadow, scale, background-color",
      "transition-duration": "var(--duration-press)",
      "transition-timing-function": "var(--ease-out)"
    },
    "[data-slot=\"button\"]:active:not(:disabled)": {
      "scale": "var(--scale-press)"
    },
    "[data-slot=\"checkbox-indicator\"]": {
      "transition-property": "opacity, scale",
      "transition-duration": "var(--duration-tick)",
      "transition-timing-function": "var(--ease-out), var(--ease-pop)"
    },
    "[data-slot=\"checkbox-indicator\"][data-starting-style]": {
      "opacity": "0",
      "scale": "var(--scale-tick)"
    },
    ":is([data-slot=\"progress-indicator\"], [data-slot=\"meter-indicator\"])": {
      "transition-property": "width",
      "transition-duration": "300ms",
      "transition-timing-function": "var(--ease-out)"
    },
    ":is( [data-slot=\"sidebar-gap\"], [data-slot=\"sidebar-container\"], [data-slot=\"sidebar-group-label\"] )": {
      "transition-duration": "var(--duration-move)",
      "transition-timing-function": "var(--ease-in-out)"
    },
    "[data-slot=\"sidebar-rail\"]": {
      "transition-property": "translate",
      "transition-duration": "var(--duration-move)",
      "transition-timing-function": "var(--ease-in-out)"
    },
    "@media (prefers-reduced-motion: reduce)": {
      ":root, :root[data-motion]": {
        "--scale-press": "1",
        "--scale-tooltip": "1",
        "--scale-popup": "1",
        "--scale-modal": "1",
        "--scale-tick": "1",
        "--ease-pop": "var(--ease-out)",
        "--ease-toggle": "var(--ease-out)"
      },
      ":is([data-slot=\"dialog-popup\"], [data-slot=\"alert-dialog-popup\"], [data-slot=\"sheet-popup\"]):is( [data-starting-style], [data-ending-style] )": {
        "translate": "none"
      },
      "[data-slot=\"drawer-popup\"]:is([data-starting-style], [data-ending-style])": {
        "transform": "none",
        "opacity": "0"
      },
      ":is( [data-slot=\"accordion-panel\"], [data-slot=\"collapsible-panel\"], [data-slot=\"tab-indicator\"], [data-slot=\"sidebar-gap\"], [data-slot=\"sidebar-container\"], [data-slot=\"sidebar-rail\"] )": {
        "transition-duration": "0ms"
      }
    },
    ":root[data-motion=\"off\"] *:not(.animate-spin, [data-slot=\"skeleton\"]), :root[data-motion=\"off\"] *::before, :root[data-motion=\"off\"] *::after": {
      "transition-duration": "0ms !important",
      "animation-duration": "0ms !important",
      "animation-delay": "0ms !important"
    },
    "@layer base": {
      "*": {
        "@apply border-border outline-ring/50": {}
      },
      "#root": {
        "isolation": "isolate"
      },
      "body": {
        "@apply bg-background text-foreground": {},
        "position": "relative"
      },
      "code, kbd, samp, pre": {
        "font-family": "var(--font-mono)"
      },
      "html": {
        "@apply font-sans antialiased": {}
      }
    }
  },
  "type": "registry:item"
}